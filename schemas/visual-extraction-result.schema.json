{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.howo.example/schemas/visual-extraction-result.schema.json",
  "title": "Visual Evidence Extraction Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "image_quality",
    "view_type",
    "observed_part_numbers",
    "label_texts",
    "visual_features",
    "fitment_terms",
    "questions_needed"
  ],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "image_quality": {"enum": ["insufficient", "limited", "usable", "clear"]},
    "view_type": {"enum": ["full_item", "label", "connector", "mounting_points", "packaging", "unknown"]},
    "observed_part_numbers": {
      "type": "array",
      "items": {"$ref": "#/$defs/ocr_item"}
    },
    "label_texts": {
      "type": "array",
      "items": {"$ref": "#/$defs/ocr_item"}
    },
    "visual_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_type", "feature_name", "feature_value", "units", "confidence"],
        "properties": {
          "feature_type": {"enum": ["shape", "mounting", "connector", "dimension", "material", "color", "marking", "fitment"]},
          "feature_name": {"type": "string", "minLength": 1},
          "feature_value": {"type": "string", "minLength": 1},
          "units": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "fitment_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "confidence"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "questions_needed": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "ocr_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text", "region", "confidence"],
      "properties": {
        "raw_text": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
