{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.howo.example/schemas/supplier-report-request.schema.json",
  "title": "Supplier Report Lookup Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "as_of", "supplier_reports"],
  "properties": {
    "product_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "fresh_for_days": {"type": "integer", "minimum": 1, "default": 30},
    "supplier_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["report_id", "supplier_id", "product_id", "availability_status", "observed_at"],
        "properties": {
          "report_id": {"type": "string", "minLength": 1},
          "supplier_id": {"type": "string", "minLength": 1},
          "supplier_name": {"type": "string"},
          "product_id": {"type": "string", "minLength": 1},
          "availability_status": {"enum": ["reported_available", "reported_low_stock", "reported_unavailable", "unknown"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "source_capture_id": {"type": "string"}
        }
      }
    }
  }
}
