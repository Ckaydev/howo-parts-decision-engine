{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.howo.example/schemas/extraction-result.schema.json",
  "title": "Capture Extraction Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "product_reference", "claims", "follow_up_questions"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "product_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mentioned_name", "mentioned_part_numbers"],
      "properties": {
        "mentioned_name": {"type": ["string", "null"]},
        "mentioned_part_numbers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_type",
          "claim_text",
          "structured_value",
          "evidence_class",
          "confidence",
          "variant_name"
        ],
        "properties": {
          "claim_type": {"type": "string", "minLength": 1},
          "claim_text": {"type": "string", "minLength": 1},
          "structured_value": {},
          "evidence_class": {
            "enum": ["observed", "user_reported", "calculated", "inferred", "unresolved"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "variant_name": {"type": ["string", "null"]}
        }
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
